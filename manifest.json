{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.4.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "identity",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-translate-page": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "__MSG_cmdTogglePage__"
    },
    "toggle-translation-only": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "__MSG_cmdToggleTranslationOnly__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/youtube-timedtext-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "i18n/lang/en.js",
        "i18n/lang/zh-CN.js",
        "i18n/lang/zh-TW.js",
        "i18n/lang/ja.js",
        "i18n/lang/ko.js",
        "i18n/lang/fr.js",
        "i18n/lang/de.js",
        "i18n/lang/es.js",
        "i18n/lang/pt.js",
        "i18n/lang/ru.js",
        "i18n/messages.js",
        "shared/account-gate.js",
        "shared/default-settings.js",
        "shared/translation-display.js",
        "shared/api-compat.js",
        "shared/engine-status.js",
        "shared/lang-tags.js",
        "shared/target-lang.js",
        "shared/caption-core.js",
        "shared/comic-charge.js",
        "shared/pdf-url.js",
        "shared/ocr.js",
        "shared/speech-lang.js",
        "shared/site-rules-builtin.js",
        "shared/site-rules.js",
        "shared/auto-stats.js",
        "shared/block-identity.js",
        "shared/translation-cache.js",
        "shared/spa-navigation.js",
        "shared/session-guard.js",
        "content/content-bootstrap.js",
        "content/content-utils.js",
        "content/content-managed-translation.js",
        "content/content-clip-guard.js",
        "content/content-fit-guard.js",
        "content/content-language.js",
        "content/content-speech.js",
        "content/engine/languages.js",
        "content/engine/watchdog.js",
        "content/content-translation-engine.js",
        "content/content-language-pack.js",
        "content/content-translation-cache.js",
        "content/content-caption-providers.js",
        "content/content-caption-controls.js",
        "content/captions/state.js",
        "content/captions/overlay.js",
        "content/captions/translate.js",
        "content/captions/activation.js",
        "content/content-video-captions.js",
        "content/content-selection.js",
        "content/content-float-ball.js",
        "content/content-popup.js",
        "content/content-input-dialog.js",
        "content/content-input-chip.js",
        "content/page/batch.js",
        "content/page/site-adapter.js",
        "content/page/collect.js",
        "content/page/insert.js",
        "content/page/visibility.js",
        "content/page/display.js",
        "content/page/progress.js",
        "content/content-page-translation.js",
        "content/content-auto-discover.js",
        "content/content-auto-translate.js",
        "content/content-auto-status.js",
        "content/content-pdf-prompt.js",
        "content/hover/blocks.js",
        "content/hover/inline.js",
        "content/hover/latex.js",
        "content/hover/selection.js",
        "content/hover/render.js",
        "content/content-hover-translation.js",
        "content/content-image-ocr.js",
        "content/comic/pages.js",
        "content/comic/entries.js",
        "content/comic/overlay.js",
        "content/comic/memory.js",
        "content/comic/prompts.js",
        "content/content-comic-translation.js",
        "content/content-messaging.js",
        "content/content.js"
      ],
      "css": [
        "content/css/popup.css",
        "content/css/translation.css",
        "content/css/progress.css",
        "content/css/selection-button.css",
        "content/css/float-ball.css",
        "content/css/auto-translate-bar.css",
        "content/css/float-menu.css",
        "content/css/input-dialog.css",
        "content/css/light-theme.css",
        "content/css/captions.css",
        "content/css/comic.css",
        "content/css/image-ocr.css"
      ],
      "run_at": "document_end"
    }
  ]
}
